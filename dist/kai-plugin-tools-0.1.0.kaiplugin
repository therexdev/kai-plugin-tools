{"manifest":{"schema":1,"apiVersion":2,"id":"kai.tools","name":"KAI Tools","version":"0.1.0","description":"Manage MCP tool servers, inspect their tools, and review every launch and action.","entry":"index.html","permissions":["tools.read","tools.manage","tools.execute"]},"files":{"app.js":"\"use strict\";\nfunction parseJson(text, kind) { let value; try { value = JSON.parse(text); } catch { throw Error(`Enter valid JSON for ${kind === \"array\" ? \"arguments\" : \"tool arguments\"}.`); } if (kind === \"array\" ? !Array.isArray(value) || value.some(v => typeof v !== \"string\") : !value || typeof value !== \"object\" || Array.isArray(value)) throw Error(kind === \"array\" ? \"Arguments must be a JSON array of strings.\" : \"Tool arguments must be a JSON object.\"); return value; }\nfunction escapeHtml(value) { return String(value ?? \"\").replace(/[&<>\"']/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c])); }\nif (typeof module !== \"undefined\") module.exports = { parseJson, escapeHtml };\nif (typeof document !== \"undefined\") {\n  const $ = id => document.getElementById(id), esc = escapeHtml;\n  let state = {servers:[]}, catalog = [], busy = false, templateFolder = false;\n  function notice(message, error = false) { $(\"notice\").textContent = message; $(\"notice\").className = error ? \"error\" : \"\"; $(\"notice\").hidden = !message; }\n  async function call(method, input = {}) { if (!window.kai?.call) throw Error(\"Open this plugin inside KAI Core 0.2.0 or later.\"); return window.kai.call(method, input); }\n  async function action(fn, success = \"\") { if (busy) return; busy = true; for (const b of document.querySelectorAll(\"button\")) b.disabled = true; notice(\"Waiting for Core…\"); try { const result = await fn(); notice(result?.cancelled ? \"Cancelled. No action was taken.\" : success); } catch(e) { notice(e.message || \"The action failed.\", true); } finally { busy = false; for (const b of document.querySelectorAll(\"button\")) b.disabled = false; } }\n  function tab(name) { for (const id of [\"servers\",\"add\",\"inspect\"]) $(id).hidden = id !== name; for (const b of document.querySelectorAll(\"[data-tab]\")) b.setAttribute(\"aria-selected\", String(b.dataset.tab === name)); }\n  for (const b of document.querySelectorAll(\"[data-tab]\")) b.onclick = () => tab(b.dataset.tab);\n  function render() {\n    $(\"privacy\").textContent = state.privacyMode || \"Privacy unavailable\";\n    $(\"server-list\").innerHTML = state.servers.length ? state.servers.map(s => `<article class=\"card\"><div class=\"spread\"><h3>${esc(s.name)}</h3><span class=\"status\">${s.connected ? \"Connected\" : \"Stopped\"}</span></div><p class=\"muted\">${s.transport === \"stdio\" ? \"Local program · \" + (s.localSafe ? \"Offline approved\" : \"Online mode required\") : esc(s.url)}</p><p class=\"mini muted\">${s.connected ? s.tools.length + \" tools discovered\" : \"Connect to discover its tools\"}</p><div class=\"actions\"><button data-server=\"${esc(s.id)}\" data-action=\"${s.connected ? \"disconnect\" : \"connect\"}\">${s.connected ? \"Stop server\" : \"Review and connect\"}</button>${s.connected ? `<button data-server=\"${esc(s.id)}\" data-action=\"inspect\">Explore tools</button>` : \"\"}<button class=\"danger\" data-server=\"${esc(s.id)}\" data-action=\"remove\">Remove</button></div></article>`).join(\"\") : '<div class=\"empty\">No servers yet. Add an MCP endpoint or a trusted local tool server.</div>';\n    for (const b of $(\"server-list\").querySelectorAll(\"button\")) b.onclick = () => { if (b.dataset.action === \"inspect\") { $(\"run-server\").value = b.dataset.server; renderTools(); tab(\"inspect\"); } else void action(async () => { const result = await call(`tools.${b.dataset.action}`, {id:b.dataset.server}); await refresh(); return result; }, \"Server updated.\"); };\n    const prior = $(\"run-server\").value;\n    $(\"run-server\").innerHTML = '<option value=\"\">Select a connected server</option>' + state.servers.filter(s => s.connected).map(s => `<option value=\"${esc(s.id)}\">${esc(s.name)}</option>`).join(\"\");\n    if (state.servers.some(s => s.connected && s.id === prior)) $(\"run-server\").value = prior;\n    renderTools();\n  }\n  function renderTools() { const server = state.servers.find(s => s.id === $(\"run-server\").value), old = $(\"run-tool\").value; $(\"run-tool\").innerHTML = '<option value=\"\">Select a tool</option>' + (server?.tools || []).map(t => `<option value=\"${esc(t.name)}\">${esc(t.name)}</option>`).join(\"\"); if (server?.tools.some(t => t.name === old)) $(\"run-tool\").value = old; renderTool(); }\n  function renderTool() { const tool = state.servers.find(s => s.id === $(\"run-server\").value)?.tools.find(t => t.name === $(\"run-tool\").value); $(\"tool-description\").textContent = tool?.description || \"Connect a server, then choose one of its tools.\"; $(\"tool-schema\").textContent = JSON.stringify(tool?.inputSchema || {}, null, 2); }\n  async function refresh() { state = await call(\"tools.status\"); render(); }\n  function transport() { const stdio = $(\"transport\").value === \"stdio\"; $(\"stdio-fields\").hidden = !stdio; $(\"http-fields\").hidden = stdio; $(\"command\").required = stdio; $(\"url\").required = !stdio; }\n  $(\"transport\").onchange = transport; $(\"run-server\").onchange = renderTools; $(\"run-tool\").onchange = renderTool;\n  $(\"refresh\").onclick = () => action(refresh);\n  $(\"server-form\").onsubmit = event => { event.preventDefault(); void action(async () => { const input = {name:$(\"name\").value,transport:$(\"transport\").value,localSafe:$(\"local-safe\").checked}; if (input.transport === \"http\") input.url = $(\"url\").value; else { input.command = $(\"command\").value; input.args = parseJson($(\"args\").value,\"array\"); if (templateFolder) { if (!$(\"folder\").value.trim()) throw Error(\"Enter the full folder path for this template.\"); input.args.push($(\"folder\").value.trim()); } } const result = await call(\"tools.add\",input); if (!result.cancelled) { $(\"server-form\").reset(); templateFolder = false; $(\"folder-label\").hidden = true; transport(); await refresh(); tab(\"servers\"); } return result; }, \"Saved. Connect the server when you are ready.\"); };\n  $(\"tool-form\").onsubmit = event => { event.preventDefault(); void action(async () => { if (!$(\"run-server\").value || !$(\"run-tool\").value) throw Error(\"Select a connected server and a tool first.\"); const result = await call(\"tools.call\", {id:$(\"run-server\").value,name:$(\"run-tool\").value,args:parseJson($(\"tool-args\").value,\"object\")}); if (!result.cancelled) $(\"result\").textContent = result.result; return result; }, \"Tool completed.\"); };\n  const runtime = install => action(async () => { const result = await call(\"tools.runtime\",{install}); if (!result.cancelled) $(\"runtime-status\").textContent = result.available ? `${result.source} · ${result.version || \"Ready\"}` : result.installable ? \"Runtime available to download\" : \"No runtime build is available for this platform. Install Node on your system.\"; return result; });\n  $(\"runtime-check\").onclick = () => runtime(false); $(\"runtime-install\").onclick = () => runtime(true);\n  void action(async () => { await refresh(); catalog = await call(\"tools.catalog\"); $(\"catalog\").innerHTML = catalog.map((c,i) => `<article><h3>${esc(c.name)}</h3><p class=\"muted\">${esc(c.description)}</p><button data-template=\"${i}\">Use template</button></article>`).join(\"\"); for (const b of $(\"catalog\").querySelectorAll(\"button\")) b.onclick = () => { const c = catalog[Number(b.dataset.template)]; $(\"name\").value = c.name; $(\"transport\").value = c.transport; $(\"command\").value = c.command; $(\"args\").value = JSON.stringify(c.args,null,2); $(\"local-safe\").checked = false; templateFolder = !!c.argsPrompt; $(\"folder-label\").hidden = !templateFolder; $(\"folder\").value = \"\"; transport(); $(\"name\").focus(); }; });\n}\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'\"><title>KAI Tools</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><main>\n<header><div><div class=\"eyebrow\">KAI / Tools</div><h1>Give your ideas more reach.</h1><p class=\"lead\">Connect MCP servers, explore what they can do, and review each action before it runs.</p></div><span class=\"pill\" id=\"privacy\">Connecting to Core</span></header>\n<div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div><nav aria-label=\"Tools sections\"><button data-tab=\"servers\" aria-selected=\"true\">Your servers</button><button data-tab=\"add\" aria-selected=\"false\">Add a server</button><button data-tab=\"inspect\" aria-selected=\"false\">Run a tool</button></nav>\n<section id=\"servers\"><div class=\"panel spread\"><div><h2>Ready when you are</h2><p class=\"muted\">Servers start only when you connect. Closing Tools stops its running servers.</p></div><button id=\"refresh\">Refresh</button></div><div id=\"server-list\" class=\"cards\"></div><div class=\"panel runtime\"><h2>Node runtime</h2><p class=\"muted\">Needed by npm-based tool servers. Use your installed Node, or download KAI's private runtime.</p><div class=\"actions\"><button id=\"runtime-check\">Check runtime</button><button id=\"runtime-install\">Set up runtime</button><span id=\"runtime-status\" class=\"muted\"></span></div></div></section>\n<section id=\"add\" hidden><div class=\"grid\"><form class=\"panel stack\" id=\"server-form\"><h2>Add your server</h2><label>Name<input id=\"name\" required maxlength=\"60\" placeholder=\"My tools\"></label><label>Connection<select id=\"transport\"><option value=\"http\">Streamable HTTP</option><option value=\"stdio\">Local program (stdio)</option></select></label><div id=\"http-fields\"><label>Server URL<input id=\"url\" type=\"url\" placeholder=\"https://example.com/mcp\"></label><p class=\"mini muted\">HTTPS, or HTTP on localhost. URLs with passwords are rejected.</p></div><div id=\"stdio-fields\" class=\"stack\" hidden><label>Executable<input id=\"command\" placeholder=\"npx or a full executable path\"></label><label>Arguments (JSON array)<textarea id=\"args\" spellcheck=\"false\">[]</textarea></label><label id=\"folder-label\" hidden>Additional folder argument<input id=\"folder\" placeholder=\"Full path to a folder\"></label><label class=\"check\"><input id=\"local-safe\" type=\"checkbox\">I trust this program to work offline in Local-Only mode.</label><p class=\"note\">Local servers run as your OS user and may access files and the network. Start only programs you trust. KAI does not sandbox these programs.</p></div><button class=\"primary\" type=\"submit\">Review and save server</button></form><div><div class=\"panel\"><h2>Start from a template</h2><p class=\"muted\">Pinned npm packages from KAI's bundled catalog. Review the executable and any folder access before starting.</p><div id=\"catalog\" class=\"stack\"></div></div></div></div></section>\n<section id=\"inspect\" hidden><div class=\"grid\"><form class=\"panel stack\" id=\"tool-form\"><h2>Inspect, then run</h2><label>Connected server<select id=\"run-server\"></select></label><label>Tool<select id=\"run-tool\"></select></label><p id=\"tool-description\" class=\"muted\"></p><details><summary>Input schema</summary><pre id=\"tool-schema\">{}</pre></details><label>Arguments (JSON object)<textarea id=\"tool-args\" rows=\"8\" spellcheck=\"false\">{}</textarea></label><button class=\"primary\" type=\"submit\">Review and run</button></form><div class=\"panel\"><h2>Result</h2><p class=\"muted\">The selected server receives your arguments. Its output appears here.</p><pre id=\"result\">No tool has run yet.</pre></div></div></section><footer>KAI Tools 0.1.0 · Requires KAI Core 0.2.0 · Each launch and action is reviewed in Core.</footer></main><script src=\"app.js\"></script></body></html>","style.css":":root{color-scheme:dark;--bg:#10151c;--panel:#19222d;--line:#2c3948;--text:#e8edf3;--muted:#9fafc0;--accent:#82dec4;--danger:#ffb3ac;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-size:14px;line-height:1.55}main{max-width:1220px;margin:auto;padding:38px 38px 70px}header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:30px}.eyebrow{text-transform:uppercase;color:var(--accent);font-size:11px;letter-spacing:.17em;font-weight:700}h1{font-size:32px;letter-spacing:-.035em;line-height:1.2;margin:8px 0 12px}h2{font-size:19px;margin:0 0 8px}h3{font-size:16px;margin:0 0 5px}p{margin:0 0 14px}.muted,small{color:var(--muted)}.lead{max-width:640px;color:var(--muted)}.pill{border:1px solid var(--line);padding:6px 11px;border-radius:30px;font-size:12px;white-space:nowrap;color:var(--accent)}nav{display:flex;gap:7px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:24px;overflow:auto}button{font:inherit;font-weight:600;background:#253343;color:var(--text);border:1px solid #394c60;border-radius:9px;padding:9px 14px;cursor:pointer}button:hover{background:#35495e}button.primary{background:var(--accent);color:#102620;border-color:var(--accent)}button.primary:hover{background:#a3efd9}button.danger{color:var(--danger)}button:disabled{opacity:.5;cursor:wait}nav button{border-color:transparent;background:transparent;color:var(--muted)}nav button[aria-selected=\"true\"]{background:#223930;color:var(--accent)}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;margin-bottom:20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:12px;padding:20px;background:#17202a;min-width:0;overflow-wrap:anywhere}.card .actions{margin-top:18px}.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.spread{display:flex;justify-content:space-between;gap:12px;align-items:start}.stack{display:grid;gap:15px}label{display:grid;gap:6px;color:var(--muted);font-size:13px}label.check{display:flex;align-items:start;gap:9px}input,select,textarea{font:inherit;color:var(--text);border:1px solid #3a4b60;background:#111923;border-radius:8px;padding:10px;width:100%;min-width:0}input[type=\"checkbox\"]{width:17px;height:17px;accent-color:var(--accent);flex:none;margin-top:2px}textarea{resize:vertical;min-height:100px;font-family:ui-monospace,monospace;font-size:12px}pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:460px;overflow:auto;background:#111923;border:1px solid var(--line);border-radius:9px;padding:16px;font-size:12px;margin:12px 0 0}#notice{padding:12px 16px;margin:0 0 20px;border:1px solid #3d796a;border-radius:10px;background:#17312b;overflow-wrap:anywhere}#notice.error{border-color:#8c4c46;background:#39221f;color:#ffd1cc}.empty{color:var(--muted);border:1px dashed var(--line);padding:30px;border-radius:12px;text-align:center}.note{border-left:3px solid var(--accent);padding:8px 14px;color:var(--muted);font-size:13px;margin:14px 0}.mini{font-size:12px;margin-top:5px}.tool-list{display:grid;gap:10px;margin:15px 0;max-height:360px;overflow:auto}.tool-list label{border:1px solid var(--line);border-radius:8px;padding:11px}.status{font-size:12px;color:var(--accent)}.count{font-size:28px;font-weight:600;color:var(--accent)}[hidden]{display:none!important}details summary{cursor:pointer;color:var(--muted);margin:14px 0}footer{color:var(--muted);font-size:12px;margin-top:30px}@media(max-width:750px){main{padding:24px 18px}.grid{grid-template-columns:1fr}header{align-items:start}h1{font-size:27px}.panel{padding:18px}}\n.runtime{margin-top:20px}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"ckUsFmPId6XLoyeN/RXSke65Rjxc6icCI6NpcLf3shniQ5yKRKVPwEoPZetpxK+J+ahl8v/NlBmCHvalQ7u9Bw=="}