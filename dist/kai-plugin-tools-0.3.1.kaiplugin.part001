uccess, false on failure, or undefined if preconditions not met\n */\nmodule.exports = async (connection, path) => {\n    if (![connection.states.AUTHENTICATED, connection.states.SELECTED].includes(connection.state)) {\n        // nothing to do here\n        return;\n    }\n\n    path = normalizePath(connection, path);\n\n    let response;\n    try {\n        response = await connection.exec('SUBSCRIBE', [{ type: 'ATOM', value: encodePath(connection, path) }]);\n        response.next();\n        return true;\n    } catch (err) {\n        await enhanceCommandError(err);\n        connection.log.warn({ err, cid: connection.id });\n        return false;\n    }\n};\n","service/node_modules/imapflow/lib/commands/unsubscribe.js":"'use strict';\n\nconst { encodePath, normalizePath, enhanceCommandError } = require('../tools.js');\n\n/**\n * Unsubscribes from a mailbox.\n *\n * @param {Object} connection - IMAP connection instance\n * @param {string} path - Mailbox path to unsubscribe from\n * @returns {Promise<boolean|undefined>} True on success, false on failure, or undefined if preconditions not met\n */\nmodule.exports = async (connection, path) => {\n    if (![connection.states.AUTHENTICATED, connection.states.SELECTED].includes(connection.state)) {\n        // nothing to do here\n        return;\n    }\n\n    path = normalizePath(connection, path);\n\n    let response;\n    try {\n        response = await connection.exec('UNSUBSCRIBE', [{ type: 'ATOM', value: encodePath(connection, path) }]);\n        response.next();\n        return true;\n    } catch (err) {\n        await enhanceCommandError(err);\n        connection.log.warn({ err, cid: connection.id });\n        return false;\n    }\n};\n","service/node_modules/imapflow/lib/connection-deadline.js":"'use strict';\n\n// Default upper bound for establishing a usable transport, including DNS and proxy negotiation.\nconst CONNECT_TIMEOUT = 90 * 1000;\n\n/**\n * One deadline for an entire connection attempt.\n *\n * DNS 