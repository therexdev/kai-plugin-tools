{"manifest":{"schema":1,"apiVersion":2,"id":"kai.tools","name":"KAI Tools","version":"0.1.1","description":"Manage MCP tool servers, inspect their tools, and review every launch and action.","entry":"index.html","permissions":["tools.read","tools.manage","tools.execute"]},"files":{"app.js":"\"use strict\";\nfunction parseJson(text, kind) { let value; try { value = JSON.parse(text); } catch { throw Error(`Enter valid JSON for ${kind === \"array\" ? \"arguments\" : \"tool arguments\"}.`); } if (kind === \"array\" ? !Array.isArray(value) || value.some(v => typeof v !== \"string\") : !value || typeof value !== \"object\" || Array.isArray(value)) throw Error(kind === \"array\" ? \"Arguments must be a JSON array of strings.\" : \"Tool arguments must be a JSON object.\"); return value; }\nfunction escapeHtml(value) { return String(value ?? \"\").replace(/[&<>\"']/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c])); }\nif (typeof module !== \"undefined\") module.exports = { parseJson, escapeHtml };\nif (typeof document !== \"undefined\") {\n  const $ = id => document.getElementById(id), esc = escapeHtml;\n  let state = {servers:[]}, catalog = [], busy = false, templateFolder = false;\n  const banner = window.KaiPluginNotice.attach($(\"notice\"), { focusTarget: () => document.querySelector('[data-tab][aria-selected=\"true\"]') });\n  function notice(message, error = false) { banner.show(message, { error, force: true }); }\n  async function call(method, input = {}) { if (!window.kai?.call) throw Error(\"Open this plugin inside KAI Core 0.2.0 or later.\"); return window.kai.call(method, input); }\n  async function action(fn, success = \"\") { if (busy) return; busy = true; for (const b of document.querySelectorAll(\"button:not(.kai-notice-close)\")) b.disabled = true; notice(\"Waiting for Core…\"); try { const result = await fn(); notice(result?.cancelled ? \"Cancelled. No action was taken.\" : success); } catch(e) { notice(e.message || \"The action failed.\", true); } finally { busy = false; for (const b of document.querySelectorAll(\"button:not(.kai-notice-close)\")) b.disabled = false; renderCatalog(); } }\n  function tab(name) { $(\"servers\").hidden = name === \"inspect\"; $(\"add\").hidden = name === \"inspect\"; $(\"add\").open = name === \"add\"; $(\"inspect\").hidden = name !== \"inspect\"; for (const b of document.querySelectorAll(\"[data-tab]\")) b.setAttribute(\"aria-selected\", String(b.dataset.tab === name)); if (name === \"add\") { $(\"add\").scrollIntoView({ block: \"nearest\" }); $(\"name\").focus(); } }\n  for (const b of document.querySelectorAll(\"[data-tab]\")) b.onclick = () => tab(b.dataset.tab);\n  function render() {\n    $(\"privacy\").textContent = state.privacyMode || \"Privacy unavailable\"; $(\"localonly-note\").hidden = state.privacyMode !== \"local-only\";\n    $(\"server-list\").innerHTML = state.servers.length ? state.servers.map(s => `<article class=\"tool-row\"><div class=\"tool-row-head\"><strong>${esc(s.name)}</strong><span class=\"muted\">${s.transport === \"stdio\" ? \"Runs on this machine\" : \"Web server\"}</span><span class=\"status ${s.connected ? \"connected\" : \"\"}\">${s.connected ? \"Connected · \" + s.tools.length + \" tools\" : \"Not connected\"}</span></div><p class=\"mini muted\">${s.transport === \"stdio\" ? s.localSafe ? \"Offline approved\" : \"Online mode required\" : esc(s.url)}</p><div class=\"tool-controls\"><button data-server=\"${esc(s.id)}\" data-action=\"${s.connected ? \"disconnect\" : \"connect\"}\">${s.connected ? \"Disconnect\" : \"Connect\"}</button>${s.connected ? `<button data-server=\"${esc(s.id)}\" data-action=\"inspect\">Explore tools</button>` : \"\"}<button class=\"danger\" data-server=\"${esc(s.id)}\" data-action=\"remove\">Remove</button></div></article>`).join(\"\") : '<div class=\"empty\">No tool servers yet — add one below to make its tools available.</div>';\n    for (const b of $(\"server-list\").querySelectorAll(\"button\")) b.onclick = () => { if (b.dataset.action === \"inspect\") { $(\"run-server\").value = b.dataset.server; renderTools(); tab(\"inspect\"); } else void action(async () => { const result = await call(`tools.${b.dataset.action}`, {id:b.dataset.server}); await refresh(); return result; }, \"Server updated.\"); };\n    const prior = $(\"run-server\").value;\n    $(\"run-server\").innerHTML = '<option value=\"\">Select a connected server</option>' + state.servers.filter(s => s.connected).map(s => `<option value=\"${esc(s.id)}\">${esc(s.name)}</option>`).join(\"\");\n    if (state.servers.some(s => s.connected && s.id === prior)) $(\"run-server\").value = prior;\n    renderTools(); renderCatalog();\n  }\n  function renderTools() { const server = state.servers.find(s => s.id === $(\"run-server\").value), old = $(\"run-tool\").value; $(\"run-tool\").innerHTML = '<option value=\"\">Select a tool</option>' + (server?.tools || []).map(t => `<option value=\"${esc(t.name)}\">${esc(t.name)}</option>`).join(\"\"); if (server?.tools.some(t => t.name === old)) $(\"run-tool\").value = old; renderTool(); }\n  function renderTool() { const tool = state.servers.find(s => s.id === $(\"run-server\").value)?.tools.find(t => t.name === $(\"run-tool\").value); $(\"tool-description\").textContent = tool?.description || \"Connect a server, then choose one of its tools.\"; $(\"tool-schema\").textContent = JSON.stringify(tool?.inputSchema || {}, null, 2); }\n  async function refresh() { state = await call(\"tools.status\"); render(); }\n  function transport() { const stdio = $(\"transport\").value === \"stdio\"; $(\"stdio-fields\").hidden = !stdio; $(\"http-fields\").hidden = stdio; $(\"command\").required = stdio; $(\"url\").required = !stdio; }\n  $(\"transport\").onchange = transport; $(\"run-server\").onchange = renderTools; $(\"run-tool\").onchange = renderTool;\n  $(\"refresh\").onclick = () => action(refresh); $(\"cancel-add\").onclick = () => tab(\"servers\");\n  $(\"server-form\").onsubmit = event => { event.preventDefault(); void action(async () => { const input = {name:$(\"name\").value,transport:$(\"transport\").value,localSafe:$(\"local-safe\").checked}; if (input.transport === \"http\") input.url = $(\"url\").value; else { input.command = $(\"command\").value; input.args = parseJson($(\"args\").value,\"array\"); if (templateFolder) { if (!$(\"folder\").value.trim()) throw Error(\"Enter the full folder path for this template.\"); input.args.push($(\"folder\").value.trim()); } } const result = await call(\"tools.add\",input); if (!result.cancelled) { $(\"server-form\").reset(); templateFolder = false; $(\"folder-label\").hidden = true; transport(); await refresh(); tab(\"servers\"); } return result; }, \"Saved. Connect the server when you are ready.\"); };\n  $(\"tool-form\").onsubmit = event => { event.preventDefault(); void action(async () => { if (!$(\"run-server\").value || !$(\"run-tool\").value) throw Error(\"Select a connected server and a tool first.\"); const result = await call(\"tools.call\", {id:$(\"run-server\").value,name:$(\"run-tool\").value,args:parseJson($(\"tool-args\").value,\"object\")}); if (!result.cancelled) $(\"result\").textContent = result.result; return result; }, \"Tool completed.\"); };\n  const runtime = install => action(async () => { const result = await call(\"tools.runtime\",{install}); if (!result.cancelled) $(\"runtime-status\").textContent = result.available ? `${result.source} · ${result.version || \"Ready\"}` : result.installable ? \"Runtime available to download\" : \"No runtime build is available for this platform. Install Node on your system.\"; return result; });\n  $(\"runtime-check\").onclick = () => runtime(false); $(\"runtime-install\").onclick = () => runtime(true);\n  function renderCatalog() {\n    const keep = $(\"catalog-select\").value, names = new Set(state.servers.map(server => server.name));\n    const available = catalog.filter(entry => !names.has(entry.name));\n    $(\"catalog-select\").innerHTML = available.length ? available.map(entry => `<option value=\"${esc(entry.id)}\">${esc(entry.name)}</option>`).join(\"\") : '<option value=\"\">No additional catalog servers</option>';\n    if (available.some(entry => entry.id === keep)) $(\"catalog-select\").value = keep;\n    $(\"catalog-select\").disabled = !available.length; $(\"catalog-add\").disabled = !available.length;\n    describeCatalog();\n  }\n  function describeCatalog() { const entry = catalog.find(item => item.id === $(\"catalog-select\").value); $(\"catalog-description\").textContent = entry?.description || \"Add your own MCP server below.\"; }\n  $(\"catalog-select\").onchange = describeCatalog;\n  $(\"catalog-add\").onclick = () => {\n    const c = catalog.find(entry => entry.id === $(\"catalog-select\").value); if (!c) return;\n    $(\"name\").value = c.name; $(\"transport\").value = c.transport; $(\"command\").value = c.command || \"\"; $(\"url\").value = c.url || \"\"; $(\"args\").value = JSON.stringify(c.args || [], null, 2); $(\"local-safe\").checked = false;\n    templateFolder = !!c.argsPrompt; $(\"folder-label\").hidden = !templateFolder; $(\"folder\").value = \"\"; transport(); tab(\"add\");\n  };\n  void action(async () => { await refresh(); catalog = await call(\"tools.catalog\"); renderCatalog(); });\n}\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'\"><title>KAI Tools</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<header class=\"workspace-header\"><div class=\"workspace-name\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m13 7 4 4M15 3a6 6 0 0 0-7 7L2 16a3 3 0 0 0 6 6l6-6a6 6 0 0 0 7-7l-4 4-6-6Z\"/></svg><h1>Tools</h1></div><span class=\"pill\" id=\"privacy\">Connecting to Core</span></header>\n<main class=\"workspace-page\"><div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div><div class=\"api-card\"><div class=\"page-heading\"><div><h1>Tools &amp; accounts</h1><p class=\"lead\">Give your AI abilities with tool servers. Review each server and action before it runs.</p></div><button id=\"refresh\">Refresh</button></div><p id=\"localonly-note\" class=\"local-note\" hidden>Privacy mode is <strong>Local-Only</strong>: tools that talk to the internet are paused. Choose an online mode in Core Settings to use them.</p>\n<nav aria-label=\"Tools sections\"><button data-tab=\"servers\" aria-selected=\"true\">Tool servers</button><button data-tab=\"add\" aria-selected=\"false\">Add a server</button><button data-tab=\"inspect\" aria-selected=\"false\">Run a tool</button></nav>\n<section id=\"servers\"><h2 class=\"section-title\">Tool servers <span class=\"muted\">(Model Context Protocol)</span></h2><div id=\"server-list\"></div>\n<div class=\"catalog-picker\"><label class=\"sr-only\" for=\"catalog-select\">Choose a tool server</label><select id=\"catalog-select\"><option value=\"\">Loading tool servers…</option></select><button id=\"catalog-add\" class=\"primary\" type=\"button\">Add</button></div><p id=\"catalog-description\" class=\"muted\"></p><div id=\"catalog\" hidden></div>\n<div class=\"runtime\"><p class=\"muted\">Most tool servers need Node.js. Use an installed copy or KAI's managed runtime.</p><div class=\"actions\"><span id=\"runtime-status\" class=\"muted\">Check the runtime before starting a local server.</span><button id=\"runtime-check\" class=\"text-button\">Check runtime</button><button id=\"runtime-install\">Set up tool runtime</button></div></div>\n</section>\n<details id=\"add\"><summary>Add your own (URL or command)</summary><form class=\"stack\" id=\"server-form\"><div class=\"form-grid\"><label>Name<input id=\"name\" required maxlength=\"60\" placeholder=\"My tools\"></label><label>Connection<select id=\"transport\"><option value=\"http\">Web server (HTTP)</option><option value=\"stdio\">Local command</option></select></label></div><div id=\"http-fields\"><label>Server URL<input id=\"url\" type=\"url\" placeholder=\"https://… (an MCP server URL)\"></label><p class=\"mini muted\">Use HTTPS, or HTTP on localhost. URLs with passwords are rejected.</p></div><div id=\"stdio-fields\" class=\"stack\" hidden><label>Executable<input id=\"command\" placeholder=\"npx or a full executable path\"></label><label>Arguments (JSON array)<textarea id=\"args\" spellcheck=\"false\">[]</textarea></label><label id=\"folder-label\" hidden>Additional folder argument<input id=\"folder\" placeholder=\"Full path to a folder\"></label><label class=\"check\"><input id=\"local-safe\" type=\"checkbox\">I trust this program to work offline in Local-Only mode.</label><p class=\"note\">Local servers run as your OS user and may access files and the network. Start only programs you trust.</p></div><div class=\"actions\"><button class=\"primary\" type=\"submit\">Review and add server</button><button id=\"cancel-add\" type=\"button\">Cancel</button></div></form></details>\n<p class=\"account-note\">Manage what KAI remembers in the Brain plugin. Connect email, calendar, and other apps in Connections.</p>\n<section id=\"inspect\" hidden><div class=\"section-heading\"><h2>Run a tool</h2><button data-tab=\"servers\">Back to servers</button></div><div class=\"grid\"><form class=\"panel stack\" id=\"tool-form\"><label>Connected server<select id=\"run-server\"></select></label><label>Tool<select id=\"run-tool\"></select></label><p id=\"tool-description\" class=\"muted\"></p><details><summary>Input schema</summary><pre id=\"tool-schema\">{}</pre></details><label>Arguments (JSON object)<textarea id=\"tool-args\" rows=\"8\" spellcheck=\"false\">{}</textarea></label><button class=\"primary\" type=\"submit\">Review and run</button></form><div class=\"panel\"><h2>Result</h2><p class=\"muted\">The selected server receives your arguments. Its output appears here.</p><pre id=\"result\">No tool has run yet.</pre></div></div></section>\n</div></main><script src=\"kai-notices.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","style.css":"/* The original Tools & accounts page, in a standalone Core window. */\n:root{--line:#dce5f2;--panel:#fff;--muted:#61728d;--accent:#155eef;--danger:#c93d4c;color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#f4f7fd;color:#14284e;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif}.workspace-header{height:74px;padding:0 34px;display:flex;align-items:center;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line)}.workspace-name{display:flex;align-items:center;gap:11px}.workspace-name svg{width:21px;height:21px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-header h1{font-size:15px;font-weight:650;margin:0}.workspace-page{padding:29px 34px 40px}.api-card{max-width:1000px;margin:0 auto;padding:26px;background:#fff;border:1px solid var(--line);border-radius:16px;min-width:0}.page-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.page-heading h1{font-size:26px;letter-spacing:-.6px;font-weight:600;line-height:1.3;margin:0 0 10px}.page-heading>button{flex:none}.lead,.muted,.note{color:var(--muted)}p{font-size:12px;line-height:1.7;margin:0 0 14px}.mini,.note{font-size:11px}.pill{display:inline-flex;padding:4px 9px;border:1px solid var(--line);background:#fff;border-radius:30px;font-size:10px;color:var(--muted)}nav{display:flex;gap:5px;flex-wrap:wrap;margin:20px 0 24px;border-bottom:1px solid var(--line);padding-bottom:8px}nav button{border:0;background:none;color:var(--muted);padding:9px 12px}nav button[aria-selected=\"true\"]{background:#edf4ff;color:var(--accent)}button,input,select,textarea{font:inherit}button{border:1px solid var(--line);border-radius:9px;background:#fff;color:#14284e;padding:8px 12px;font-size:12px;cursor:pointer}button:hover:enabled{background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}.primary:hover:enabled{background:#0c4ed3;border-color:#0c4ed3}.danger{color:var(--danger)}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}input,select,textarea{width:100%;min-width:0;border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:#f5f8fe;color:#14284e;font-size:12px}textarea{min-height:80px;resize:vertical}label{font-size:12px;color:var(--muted)}h2{font-size:16px;line-height:1.4;margin:0 0 13px;font-weight:650}h3{font-size:13px;margin:0 0 10px}.section-title{margin-bottom:17px}.section-title>span{font-size:11px;font-weight:400}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}.section-heading h2{margin:0}.tool-row{border:1px solid var(--line);border-radius:11px;padding:16px 18px;margin:0 0 12px}.tool-row-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:13px}.tool-row-head .muted{font-size:11px}.tool-row-head .status{margin-left:auto}.status{font-size:10px;color:var(--muted);border-radius:30px;background:#f1f5fa;padding:4px 9px}.status.connected{color:#168469;background:#eaf8f1}.tool-row p{margin:8px 0 0}.tool-controls{display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-top:13px}.tool-controls button,.text-button{border:0;background:transparent;padding:2px 0;font-size:11px;color:var(--accent)}.tool-controls .danger{color:var(--danger)}.empty{color:var(--muted);font-size:12px;padding:10px 0 18px}.catalog-picker{display:flex;align-items:center;gap:10px;margin:16px 0 10px}.catalog-picker select{flex:1;min-width:0}.catalog-picker button{flex:none}.runtime{padding:10px 0 20px;border-bottom:1px solid var(--line)}.runtime p{font-size:11px;margin:0 0 9px}.runtime .actions{align-items:center}.runtime .actions>span{font-size:11px;margin-right:auto}.actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.stack{display:flex;flex-direction:column;gap:16px}.stack>label,.form-grid label{display:flex;flex-direction:column;gap:7px}.stack p{margin:0}.form-grid,.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;align-items:start}.form-grid label{min-width:0}.check{display:flex!important;flex-direction:row!important;align-items:flex-start;gap:10px}.check input{width:16px;height:16px;flex:none;margin:3px 0 0;padding:0;accent-color:var(--accent)}#add{border-bottom:1px solid var(--line);padding:16px 0}#add>summary{cursor:pointer;font-size:12px;color:var(--muted)}#add[open]>summary{margin-bottom:20px}#server-form{max-width:740px}#http-fields>label{display:flex;flex-direction:column;gap:7px}#http-fields>p{margin-top:8px}.account-note{margin:18px 0 0;font-size:11px;color:var(--muted)}#inspect{padding-top:22px}.panel{min-width:0;background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px}pre{max-height:440px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;padding:15px;border:1px solid var(--line);border-radius:10px;background:#f5f8fe;font:11px/1.7 Consolas,monospace}.local-note{padding:12px 14px;border:1px solid #d9e5f6;border-radius:10px;background:#f5f9ff;color:var(--muted);margin:10px 0 0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:780px){.workspace-page{padding:22px}.workspace-header{padding:0 22px}.api-card{padding:21px}.grid{grid-template-columns:1fr}.page-heading h1{font-size:23px}.runtime .actions>span{width:100%}}@media(max-width:530px){.workspace-page{padding:18px 12px}.workspace-header{padding:0 14px}.api-card{padding:17px}.page-heading{flex-wrap:wrap}.form-grid{grid-template-columns:1fr}.tool-row-head{gap:7px}.tool-row-head .status{margin-left:0}.catalog-picker{align-items:stretch}.catalog-picker select{max-width:calc(100% - 65px)}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"MHRQ+nZkLWLItfMgIabcW3e5Pm9zaOk3Am1TPaA1WyZB21aAgcTeLxBFjKXF3JgvWXApw56QzpHkVsVJ4Br0AA=="}